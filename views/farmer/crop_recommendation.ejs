                        <div class="p-3 bg-white rounded-3 border text-center">
                            <h6 class="fw-bold text-dark"><i class="fas fa-calculator me-1"></i> Layer 5: Composite Multi-Criteria Ranking</h6>
                            <p class="mb-0 text-muted">Aggregates verified layer scores: <code>S_composite = 0.35·S_soil + 0.25·S_weather + 0.20·S_context + 0.20·S_market</code> (or normalized 3-layer mode if market data is unavailable). Ranks top 2-3 crops with primary selection.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= JAVASCRIPT LOGIC ================= -->
<script>
const REGION_DATA = <%- JSON.stringify(typeof regionHierarchy !== 'undefined' ? regionHierarchy : {}) %>;

// Populate district dropdown
function updateDistrictDropdown(selectedState, selectedDistrict = '') {
    const districtSelect = document.getElementById('districtSelect');
    const customInput = document.getElementById('customDistrictInput');
    districtSelect.innerHTML = '<option value="">-- Select District --</option>';

    let matched = false;
    if (selectedState && REGION_DATA[selectedState]) {
        const districts = (REGION_DATA[selectedState].districts || []).slice().sort();
        districts.forEach(d => {
            const opt = document.createElement('option');
            opt.value = d;
            opt.textContent = d;
            if (selectedDistrict && d.toLowerCase() === selectedDistrict.toLowerCase()) {
                opt.selected = true;
                matched = true;
            } else if (!selectedDistrict && d === districts[0]) {
                opt.selected = true;
                matched = true;
            }
            districtSelect.appendChild(opt);
        });
    }

    const customOpt = document.createElement('option');
    customOpt.value = '__custom__';
    customOpt.textContent = '✏️ Other / Custom District...';
    districtSelect.appendChild(customOpt);

    if (selectedDistrict && !matched) {
        customOpt.selected = true;
        customInput.value = selectedDistrict;
        customInput.classList.remove('d-none');
    } else if (districtSelect.value !== '__custom__') {
        customInput.classList.add('d-none');
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const stateSelect = document.getElementById('stateSelect');
    updateDistrictDropdown(stateSelect.value, 'Lucknow');

    stateSelect.addEventListener('change', (e) => {
        updateDistrictDropdown(e.target.value);
    });

    const districtSelect = document.getElementById('districtSelect');
    const customDistrictInput = document.getElementById('customDistrictInput');
    districtSelect.addEventListener('change', (e) => {
        if (e.target.value === '__custom__') {
            customDistrictInput.classList.remove('d-none');
            customDistrictInput.focus();
        } else {
            customDistrictInput.classList.add('d-none');
        }
    });

    document.getElementById('toggleCustomDistrictBtn').addEventListener('click', () => {
        districtSelect.value = '__custom__';
        customDistrictInput.classList.remove('d-none');
        customDistrictInput.focus();
    });

    // Auto-fill from saved plot selector
    const savedPlotSelect = document.getElementById('savedPlotSelect');
    savedPlotSelect.addEventListener('change', (e) => {
        const opt = e.target.selectedOptions[0];
        if (!opt || !opt.value) return;

        if (opt.dataset.state) {
            stateSelect.value = opt.dataset.state;
            updateDistrictDropdown(opt.dataset.state, opt.dataset.district);
        }
        if (opt.dataset.block) document.getElementById('block_tehsil').value = opt.dataset.block;
        if (opt.dataset.village) document.getElementById('village').value = opt.dataset.village;
        if (opt.dataset.lat) document.getElementById('latitude').value = opt.dataset.lat;
        if (opt.dataset.lon) document.getElementById('longitude').value = opt.dataset.lon;
        if (opt.dataset.soil) document.getElementById('soil_type').value = opt.dataset.soil;
    });
});

// GPS Detection
document.getElementById('detectGpsBtn').addEventListener('click', () => {
    const statusBadge = document.getElementById('gpsStatusBadge');
    const alertBox = document.getElementById('gpsAlert');
    const btn = document.getElementById('detectGpsBtn');

    if (!navigator.geolocation) {
        alertBox.className = 'small mt-2 alert alert-danger p-2 rounded-3';
        alertBox.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> Geolocation not supported in browser.';
        alertBox.classList.remove('d-none');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Acquiring GPS...';
    statusBadge.className = 'badge bg-warning text-dark rounded-pill px-2';
    statusBadge.textContent = 'Acquiring GPS';

    navigator.geolocation.getCurrentPosition(
        async (position) => {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;
            const acc = Math.round(position.coords.accuracy || 10);

            document.getElementById('latitude').value = lat.toFixed(4);
            document.getElementById('longitude').value = lon.toFixed(4);

            try {
                const res = await fetch('/api/soil/reverse-geocode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ latitude: lat, longitude: lon })
                });
                const loc = await res.json();
                if (loc.state) {
                    const stSelect = document.getElementById('stateSelect');
                    stSelect.value = loc.state;
                    updateDistrictDropdown(loc.state, loc.district);
                }
                if (loc.block) document.getElementById('block_tehsil').value = loc.block;
                if (loc.village) document.getElementById('village').value = loc.village;

                statusBadge.className = 'badge bg-success text-white rounded-pill px-2';
                statusBadge.textContent = 'GPS Locked';

                alertBox.className = 'small mt-2 alert alert-success p-2 rounded-3';
                alertBox.innerHTML = `<i class="fas fa-check-circle me-1"></i> GPS: <strong>${loc.village || ''}, ${loc.district}, ${loc.state}</strong> (±${acc}m)`;
                alertBox.classList.remove('d-none');
            } catch (e) {
                statusBadge.className = 'badge bg-success text-white rounded-pill px-2';
                statusBadge.textContent = 'Coordinates Set';
            }

            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Re-detect GPS';
        },
        (error) => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Auto-Detect Browser GPS';
            statusBadge.className = 'badge bg-danger text-white rounded-pill px-2';
            statusBadge.textContent = 'GPS Failed';

            let msg = 'Could not acquire GPS.';
            if (error.code === error.PERMISSION_DENIED) {
                msg = 'Location permission was denied. Please select your State and District manually.';
            }
            alertBox.className = 'small mt-2 alert alert-warning p-2 rounded-3';
            alertBox.innerHTML = `<i class="fas fa-exclamation-circle me-1"></i> ${msg}`;
            alertBox.classList.remove('d-none');
        },
        { enableHighAccuracy: true, timeout: 8000 }
    );
});

// Run Crop Recommendation
document.getElementById('runRecommendationBtn').addEventListener('click', async () => {
    const errBox = document.getElementById('validationErrorAlert');
    errBox.classList.add('d-none');

    const getSelectedDistrict = () => {
        const select = document.getElementById('districtSelect');
        const custom = document.getElementById('customDistrictInput');
        if (select.value === '__custom__' || !select.value) {
            return custom.value.trim() || 'Central District';
        }
        return select.value;
    };

    const payload = {
        n_value: document.getElementById('n_value').value,
        p_value: document.getElementById('p_value').value,
        k_value: document.getElementById('k_value').value,
        ph_value: document.getElementById('ph_value').value,
        season: document.getElementById('season').value,
        soil_type: document.getElementById('soil_type').value,
        state: document.getElementById('stateSelect').value,
        district: getSelectedDistrict(),
        block_tehsil: document.getElementById('block_tehsil').value,
        village: document.getElementById('village').value,
        latitude: document.getElementById('latitude').value,
        longitude: document.getElementById('longitude').value,
        irrigation_type: document.getElementById('irrigation_type').value
    };

    const runBtn = document.getElementById('runRecommendationBtn');
    runBtn.disabled = true;
    runBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Computing 5 Layers...';

    document.getElementById('recPlaceholder').classList.add('d-none');
    document.getElementById('recResultsContainer').classList.add('d-none');
    document.getElementById('recLoading').classList.remove('d-none');

    try {
        const response = await fetch('/api/crop/recommend', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!data.success) {
            document.getElementById('recLoading').classList.add('d-none');
            document.getElementById('recPlaceholder').classList.remove('d-none');
            errBox.textContent = data.error || 'Failed to compute crop recommendation.';
            errBox.classList.remove('d-none');
            runBtn.disabled = false;
            runBtn.innerHTML = '<i class="fas fa-cogs me-2"></i> Compute 5-Layer Crop Recommendation';
            return;
        }

        renderCropRecommendation(data);

        document.getElementById('recLoading').classList.add('d-none');
        document.getElementById('recResultsContainer').classList.remove('d-none');
    } catch (err) {
        document.getElementById('recLoading').classList.add('d-none');
        document.getElementById('recPlaceholder').classList.remove('d-none');
        errBox.textContent = 'Server Connection Error: ' + err.message;
        errBox.classList.remove('d-none');
    }

    runBtn.disabled = false;
    runBtn.innerHTML = '<i class="fas fa-cogs me-2"></i> Compute 5-Layer Crop Recommendation';
});

// Render Bilingual Output
function renderCropRecommendation(data) {
    const primary = data.primary_recommendation;
    const weather = data.weather_context;
    const market = data.market_context;

    // 1. ENGLISH VIEW
    document.getElementById('primaryCropNameEn').textContent = primary.name_en;
    document.getElementById('primaryCropSciEn').textContent = primary.scientific_name;
    document.getElementById('primaryConfidenceEn').textContent = primary.confidence_en;
    document.getElementById('primaryScoreEn').textContent = `${primary.composite_score}%`;

    document.getElementById('scoreSoilEn').textContent = `${primary.score_breakdown.soil_score}%`;
    document.getElementById('scoreContextEn').textContent = `${primary.score_breakdown.context_score}%`;
    document.getElementById('scoreWeatherEn').textContent = `${primary.score_breakdown.weather_score}%`;

    document.getElementById('weatherContextDescEn').innerHTML = `
        <strong>${weather.temperature}</strong>, ${weather.relative_humidity} Humidity (${weather.conditions})<br>
        <span class="text-muted" style="font-size:0.75rem;">Source: ${weather.data_source}</span>
    `;

    // Reasons EN
    const reasonsListEn = document.getElementById('primaryReasonsListEn');
    reasonsListEn.innerHTML = '';
    primary.reasons_en.forEach(r => {
        const li = document.createElement('li');
        li.textContent = r;
        reasonsListEn.appendChild(li);
    });

    // Warnings EN
    const warningsSecEn = document.getElementById('warningsSecEn');
    const warningsListEn = document.getElementById('primaryWarningsListEn');
    warningsListEn.innerHTML = '';
    if (primary.warnings_en && primary.warnings_en.length > 0) {
        primary.warnings_en.forEach(w => {
            const li = document.createElement('li');
            li.textContent = w;
            warningsListEn.appendChild(li);
        });
        warningsSecEn.classList.remove('d-none');
    } else {
        warningsSecEn.classList.add('d-none');
    }

    document.getElementById('primaryAdviceEn').textContent = primary.agronomic_advice.en;

    // Alternatives EN
    const altGridEn = document.getElementById('alternativeCropsGridEn');
    altGridEn.innerHTML = '';
    data.ranked_crops.slice(1).forEach((crop, idx) => {
        const col = document.createElement('div');
        col.className = 'col-md-6';
        col.innerHTML = `
            <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge bg-secondary-subtle text-dark rounded-pill px-2 py-1 small">Rank #${idx + 2}</span>
                        <h5 class="fw-bold text-dark mb-0 mt-1">${crop.name_en}</h5>
                        <small class="text-muted">${crop.scientific_name}</small>
                    </div>
                    <span class="badge bg-success rounded-pill px-2 py-1 fs-6">${crop.composite_score}%</span>
                </div>
                <div class="d-flex justify-content-between small text-muted bg-light p-2 rounded-3 mb-2" style="font-size:0.75rem;">
                    <span>Soil: <strong>${crop.layers.soil.score}%</strong></span>
                    <span>Weather: <strong>${crop.layers.weather.score}%</strong></span>
                    <span>Context: <strong>${crop.layers.context.score}%</strong></span>
                </div>
                <p class="text-muted small mb-0">${crop.agronomic_advice.en}</p>
            </div>
        `;
        altGridEn.appendChild(col);
    });

    // 2. HINDI VIEW
    document.getElementById('primaryCropNameHi').textContent = primary.name_hi;
    document.getElementById('primaryCropSciHi').textContent = primary.scientific_name;
    document.getElementById('primaryConfidenceHi').textContent = primary.confidence_hi;
    document.getElementById('primaryScoreHi').textContent = `${primary.composite_score}%`;

    document.getElementById('scoreSoilHi').textContent = `${primary.score_breakdown.soil_score}%`;
    document.getElementById('scoreContextHi').textContent = `${primary.score_breakdown.context_score}%`;
    document.getElementById('scoreWeatherHi').textContent = `${primary.score_breakdown.weather_score}%`;

    document.getElementById('weatherContextDescHi').innerHTML = `
        <strong>${weather.temperature}</strong>, आर्द्रता ${weather.relative_humidity} (${weather.conditions})<br>
        <span class="text-muted" style="font-size:0.75rem;">मौसम स्रोत: ${weather.data_source}</span>
    `;

    // Reasons HI
    const reasonsListHi = document.getElementById('primaryReasonsListHi');
    reasonsListHi.innerHTML = '';
    primary.reasons_hi.forEach(r => {
        const li = document.createElement('li');
        li.textContent = r;
        reasonsListHi.appendChild(li);
    });

    // Warnings HI
    const warningsSecHi = document.getElementById('warningsSecHi');
    const warningsListHi = document.getElementById('primaryWarningsListHi');
    warningsListHi.innerHTML = '';
    if (primary.warnings_hi && primary.warnings_hi.length > 0) {
        primary.warnings_hi.forEach(w => {
            const li = document.createElement('li');
            li.textContent = w;
            warningsListHi.appendChild(li);
        });
        warningsSecHi.classList.remove('d-none');
    } else {
        warningsSecHi.classList.add('d-none');
    }

    document.getElementById('primaryAdviceHi').textContent = primary.agronomic_advice.hi;

    // Alternatives HI
    const altGridHi = document.getElementById('alternativeCropsGridHi');
    altGridHi.innerHTML = '';
    data.ranked_crops.slice(1).forEach((crop, idx) => {
        const col = document.createElement('div');
        col.className = 'col-md-6';
        col.innerHTML = `
            <div class="p-3 bg-white rounded-4 border shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge bg-secondary-subtle text-dark rounded-pill px-2 py-1 small">क्रम #${idx + 2}</span>
                        <h5 class="fw-bold text-dark mb-0 mt-1">${crop.name_hi}</h5>
                        <small class="text-muted">${crop.scientific_name}</small>
                    </div>
                    <span class="badge bg-success rounded-pill px-2 py-1 fs-6">${crop.composite_score}%</span>
                </div>
                <div class="d-flex justify-content-between small text-muted bg-light p-2 rounded-3 mb-2" style="font-size:0.75rem;">
                    <span>मृदा: <strong>${crop.layers.soil.score}%</strong></span>
                    <span>मौसम: <strong>${crop.layers.weather.score}%</strong></span>
                    <span>क्षेत्रीय: <strong>${crop.layers.context.score}%</strong></span>
                </div>
                <p class="text-muted small mb-0">${crop.agronomic_advice.hi}</p>
            </div>
        `;
        altGridHi.appendChild(col);
    });

    document.getElementById('recResultsContainer').scrollIntoView({ behavior: 'smooth' });
}

// Copy Summary
document.getElementById('copyRecSummaryBtn').addEventListener('click', () => {
    const cropEn = document.getElementById('primaryCropNameEn').textContent;
    const cropHi = document.getElementById('primaryCropNameHi').textContent;
    const score = document.getElementById('primaryScoreEn').textContent;
    const adviceEn = document.getElementById('primaryAdviceEn').textContent;
    const adviceHi = document.getElementById('primaryAdviceHi').textContent;

    navigator.clipboard.writeText(`[AgroHaat Hybrid Crop Recommendation]\nPrimary Crop: ${cropEn} (${cropHi}) - Score: ${score}\nEN Advice: ${adviceEn}\nHI Advice: ${adviceHi}`);
    alert('Crop recommendation summary copied to clipboard!');
});
</script>

