        </div>
    </div>

    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Client-Side Real-Time Market Intelligence Script -->
    <script>
        let currentRawRecords = <%- JSON.stringify((marketData && marketData.records) ? marketData.records : []) %>;
        let chartInstance = null;
        let currentSortColumn = 'price';
        let currentSortDirection = 'desc';

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', () => {
            recalculateNetRealization();
        });

        // Quick chip selection for top commodities
        function selectCommodityChip(cropName) {
            document.querySelectorAll('.crop-chip').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            const select = document.getElementById('commoditySelect');
            select.value = cropName;
            applyFilters();
        }

        // Quick price presets handler
        function setPricePreset(min, max, chipElement) {
            document.querySelectorAll('.price-preset-chip').forEach(c => c.classList.remove('active'));
            if (chipElement) chipElement.classList.add('active');

            document.getElementById('minPriceInput').value = min !== null ? min : '';
            document.getElementById('maxPriceInput').value = max !== null ? max : '';

            // Apply filter immediately
            filterTableLocally();
        }

        // Clear search input
        function clearSearchInput() {
            document.getElementById('searchInput').value = '';
            filterTableLocally();
        }

        // Cascading State Change -> Fetch Districts
        async function onStateChange() {
            const stateId = document.getElementById('stateSelect').value;
            const districtSelect = document.getElementById('districtSelect');
            const marketSelect = document.getElementById('marketSelect');

            districtSelect.innerHTML = '<option value="">All Districts</option>';
            marketSelect.innerHTML = '<option value="">All Mandis</option>';

            if (!stateId) {
                districtSelect.disabled = true;
                marketSelect.disabled = true;
                applyFilters();
                return;
            }

            districtSelect.disabled = false;
            try {
                const res = await fetch(`/api/market/locations?state_id=${stateId}`);
                const data = await res.json();
                if (data.success && Array.isArray(data.data)) {
                    data.data.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d.id;
                        opt.textContent = d.name;
                        districtSelect.appendChild(opt);
                    });
                }
            } catch (err) {
                console.error('Failed to load districts:', err);
            }

            applyFilters();
        }

        // Cascading District Change -> Fetch Mandis
        async function onDistrictChange() {
            const stateId = document.getElementById('stateSelect').value;
            const districtId = document.getElementById('districtSelect').value;
            const marketSelect = document.getElementById('marketSelect');

            marketSelect.innerHTML = '<option value="">All Mandis</option>';

            if (!districtId) {
                marketSelect.disabled = true;
                applyFilters();
                return;
            }

            marketSelect.disabled = false;
            try {
                const res = await fetch(`/api/market/locations?state_id=${stateId}&district_id=${districtId}`);
                const data = await res.json();
                if (data.success && Array.isArray(data.data)) {
                    data.data.forEach(m => {
                        const opt = document.createElement('option');
                        opt.value = m.id;
                        opt.textContent = m.name;
                        marketSelect.appendChild(opt);
                    });
                }
            } catch (err) {
                console.error('Failed to load markets:', err);
            }

            applyFilters();
        }

        // Apply filters via AJAX and update UI seamlessly
        async function applyFilters() {
            const commodity = document.getElementById('commoditySelect').value;
            const state = document.getElementById('stateSelect').value;
            const district = document.getElementById('districtSelect').value;
            const market = document.getElementById('marketSelect').value;
            const date = document.getElementById('dateInput').value;
            const minPrice = document.getElementById('minPriceInput').value;
            const maxPrice = document.getElementById('maxPriceInput').value;
            const sortBy = document.getElementById('sortBySelect').value;
            const search = document.getElementById('searchInput').value.trim();

            // Show table loading state
            const tbody = document.getElementById('mandiTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="9" class="text-center py-5">
                        <div class="spinner-border text-success mb-2"></div>
                        <div class="text-muted small">Fetching verified Agmarknet 2.0 records...</div>
                    </td>
                </tr>
            `;

            try {
                const params = new URLSearchParams({ commodity });
                if (state) params.append('state', state);
                if (district) params.append('district', district);
                if (market) params.append('market', market);
                if (date) params.append('date', date);
                if (minPrice) params.append('min_price', minPrice);
                if (maxPrice) params.append('max_price', maxPrice);
                if (sortBy) params.append('sort_by', sortBy);
                if (search) params.append('search', search);

                const res = await fetch(`/api/market/prices?${params.toString()}`);
                const data = await res.json();

                if (data.success) {
                    currentRawRecords = data.records;
                    updateUIWithData(data);
                } else {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="9" class="text-center py-5 text-danger">
                                <i class="fas fa-triangle-exclamation fs-3 mb-2 d-block"></i>
                                <h6>${data.message || 'Error retrieving records'}</h6>
                            </td>
                        </tr>
                    `;
                }
            } catch (err) {
                console.error('Filter request failed:', err);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center py-5 text-danger">
                            <i class="fas fa-circle-exclamation fs-3 mb-2 d-block"></i>
                            <h6>Failed to connect to the market service.</h6>
                        </td>
                    </tr>
                `;
            }
        }

        // Real-Time Local Filter & Search Engine (Supports Price Ranges, Operators, Substrings, and Text)
        function filterTableLocally() {
            const query = document.getElementById('searchInput').value.trim().toLowerCase();
            const minPriceVal = document.getElementById('minPriceInput').value ? Number(document.getElementById('minPriceInput').value) : null;
            const maxPriceVal = document.getElementById('maxPriceInput').value ? Number(document.getElementById('maxPriceInput').value) : null;

            // Parse price operators from query if present
            let queryMin = null;
            let queryMax = null;
            let queryExactNum = null;

            // Check range in query: e.g. "2500-3000" or "2500 to 3000" or "2500..3000"
            const rangeMatch = query.match(/^(\d+)\s*(?:-|to|\.\.)\s*(\d+)$/);
            if (rangeMatch) {
                queryMin = Number(rangeMatch[1]);
                queryMax = Number(rangeMatch[2]);
            } else {
                // Greater than: "> 2500", ">= 2500", "above 2500"
                const gtMatch = query.match(/^(?:>=?|>|above|over)\s*(\d+)$/);
                if (gtMatch) {
                    queryMin = Number(gtMatch[1]);
                } else {
                    // Less than: "< 3000", "<= 3000", "below 3000"
                    const ltMatch = query.match(/^(?:<=?|<|below|under)\s*(\d+)$/);
                    if (ltMatch) {
                        queryMax = Number(ltMatch[1]);
                    } else if (query && !isNaN(query)) {
                        queryExactNum = query;
                    }
                }
            }

            const rows = document.querySelectorAll('#mandiTableBody tr:not(#emptyTableRow)');
            let visibleCount = 0;
            const visibleRecords = [];

            rows.forEach(r => {
                const market = r.getAttribute('data-market') || '';
                const state = r.getAttribute('data-state') || '';
                const district = r.getAttribute('data-district') || '';
                const variety = r.getAttribute('data-variety') || '';
                const modalPrice = Number(r.getAttribute('data-modal-price')) || 0;
                const minPrice = Number(r.getAttribute('data-min-price')) || 0;
                const maxPrice = Number(r.getAttribute('data-max-price')) || 0;
                const arrivals = Number(r.getAttribute('data-arrivals')) || 0;

                let matches = true;

                // 1. Min Price check (from dedicated input or query)
                const effectiveMin = minPriceVal !== null ? minPriceVal : queryMin;
                if (effectiveMin !== null && modalPrice < effectiveMin) {
                    matches = false;
                }

                // 2. Max Price check (from dedicated input or query)
                const effectiveMax = maxPriceVal !== null ? maxPriceVal : queryMax;
                if (effectiveMax !== null && modalPrice > effectiveMax) {
                    matches = false;
                }

                // 3. Exact Price or Text Search check
                if (matches && query) {
                    if (queryMin !== null || queryMax !== null) {
                        // Handled by range/gt/lt above
                    } else if (queryExactNum !== null) {
                        // Query is a number like 2700: check if modal_price, min_price, or max_price matches or contains it
                        const numStr = queryExactNum;
                        const priceMatches = modalPrice.toString().includes(numStr) || 
                                             minPrice.toString().includes(numStr) || 
                                             maxPrice.toString().includes(numStr);
                        if (!priceMatches) {
                            matches = false;
                        }
                    } else {
                        // Text match across market, state, district, variety, and price string
                        const textMatches = market.includes(query) || 
                                            state.includes(query) || 
                                            district.includes(query) || 
                                            variety.includes(query) ||
                                            modalPrice.toString().includes(query);
                        if (!textMatches) {
                            matches = false;
                        }
                    }
                }

                if (matches) {
                    r.style.display = '';
                    visibleCount++;
                    visibleRecords.push({
                        market: r.querySelector('.fw-bold.text-dark')?.innerText || market,
                        state: r.children[1]?.innerText || state,
                        variety: r.querySelector('.badge.bg-light')?.innerText || variety,
                        modal_price: modalPrice,
                        min_price: minPrice,
                        max_price: maxPrice,
                        arrivals: arrivals
                    });
                } else {
                    r.style.display = 'none';
                }
            });

            // Handle empty state message
            let emptyRow = document.getElementById('emptyTableRow');
            if (visibleCount === 0) {
                if (!emptyRow) {
                    emptyRow = document.createElement('tr');
                    emptyRow.id = 'emptyTableRow';
                    emptyRow.innerHTML = `
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fas fa-search-dollar fs-2 mb-2 d-block text-secondary"></i>
                            <h6>No mandis found matching the specified price or search criteria.</h6>
                            <p class="small text-muted mb-2">Try clearing your price bounds or searching for a wider range.</p>
                            <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3" onclick="resetFilters()">
                                <i class="fas fa-rotate-left me-1"></i> Clear Filters
                            </button>
                        </td>
                    `;
                    document.getElementById('mandiTableBody').appendChild(emptyRow);
                } else {
                    emptyRow.style.display = '';
                }
            } else if (emptyRow) {
                emptyRow.style.display = 'none';
            }

            // Update Counter
            document.getElementById('recordCounter').innerHTML = `Showing <strong>${visibleCount}</strong> of ${rows.length} Mandis`;

            // Dynamically Recalculate and Update 5 KPI Cards for the filtered subset
            recalculateKPIsFromRecords(visibleRecords);
            recalculateNetRealization();
        }

        // Dynamically recalculate 5 KPI summary cards based on currently filtered records
        function recalculateKPIsFromRecords(records) {
            if (!records || records.length === 0) {
                document.getElementById('kpiHighestPrice').innerText = '—';
                document.getElementById('kpiHighestMandi').innerText = 'No matching mandis';
                document.getElementById('kpiLowestPrice').innerText = '—';
                document.getElementById('kpiLowestMandi').innerText = 'No matching mandis';
                document.getElementById('kpiPriceSpread').innerText = '—';
                document.getElementById('kpiSpreadPct').innerText = '0% spread';
                document.getElementById('kpiAvgPrice').innerText = '—';
                document.getElementById('kpiReportingCount').innerText = '0 Mandis Matching';
                document.getElementById('kpiTotalArrivals').innerText = '0';
                return;
            }

            let maxRec = records[0];
            let minRec = records[0];
            let sumModal = 0;
            let sumArrivals = 0;

            records.forEach(r => {
                sumModal += r.modal_price;
                sumArrivals += r.arrivals;
                if (r.modal_price > maxRec.modal_price) maxRec = r;
                if (r.modal_price < minRec.modal_price && r.modal_price > 0) minRec = r;
            });

            const avgModal = Math.round(sumModal / records.length);
            const spread = maxRec.modal_price - minRec.modal_price;
            const spreadPct = minRec.modal_price > 0 ? ((spread / minRec.modal_price) * 100).toFixed(1) : 0;

            document.getElementById('kpiHighestPrice').innerText = `₹${Number(maxRec.modal_price).toLocaleString('en-IN')}`;
            document.getElementById('kpiHighestMandi').innerText = `${maxRec.market} (${maxRec.state})`;

            document.getElementById('kpiLowestPrice').innerText = `₹${Number(minRec.modal_price).toLocaleString('en-IN')}`;
            document.getElementById('kpiLowestMandi').innerText = `${minRec.market} (${minRec.state})`;

            document.getElementById('kpiPriceSpread').innerText = `₹${Number(spread).toLocaleString('en-IN')}`;
            document.getElementById('kpiSpreadPct').innerText = `Gap: ${spreadPct}%`;

            document.getElementById('kpiAvgPrice').innerText = `₹${Number(avgModal).toLocaleString('en-IN')}`;
            document.getElementById('kpiReportingCount').innerText = `${records.length} Mandis Matching`;

            document.getElementById('kpiTotalArrivals').innerText = Number(sumArrivals.toFixed(2)).toLocaleString('en-IN');
        }

        // Sort table column on header click
        function sortTableColumn(column) {
            if (currentSortColumn === column) {
                currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortColumn = column;
                currentSortDirection = 'desc';
            }

            // Update header icons
            ['market', 'state', 'arrivals', 'min', 'max', 'price'].forEach(col => {
                const icon = document.getElementById(`sortIcon_${col}`);
                if (icon) {
                    if (col === currentSortColumn) {
                        icon.className = `fas fa-sort-${currentSortDirection === 'asc' ? 'up text-success' : 'down text-success'} ms-1`;
                    } else {
                        icon.className = 'fas fa-sort text-muted ms-1';
                    }
                }
            });

            // Map to sort select value
            const sortSelect = document.getElementById('sortBySelect');
            if (column === 'price') sortSelect.value = currentSortDirection === 'asc' ? 'price_asc' : 'price_desc';
            else if (column === 'arrivals') sortSelect.value = currentSortDirection === 'asc' ? 'arrivals_asc' : 'arrivals_desc';
            else if (column === 'market') sortSelect.value = 'market_asc';

            sortAndRenderTable();
        }

        // Sort and re-render table based on selection
        function sortAndRenderTable() {
            const sortBy = document.getElementById('sortBySelect').value;
            const tbody = document.getElementById('mandiTableBody');
            const rows = Array.from(tbody.querySelectorAll('tr:not(#emptyTableRow)'));

            rows.sort((a, b) => {
                const aPrice = Number(a.getAttribute('data-modal-price')) || 0;
                const bPrice = Number(b.getAttribute('data-modal-price')) || 0;
                const aArr = Number(a.getAttribute('data-arrivals')) || 0;
                const bArr = Number(b.getAttribute('data-arrivals')) || 0;
                const aMkt = a.getAttribute('data-market') || '';
                const bMkt = b.getAttribute('data-market') || '';

                switch (sortBy) {
                    case 'price_desc': return bPrice - aPrice;
                    case 'price_asc': return aPrice - bPrice;
                    case 'arrivals_desc': return bArr - aArr;
                    case 'arrivals_asc': return aArr - bArr;
                    case 'market_asc': return aMkt.localeCompare(bMkt);
                    case 'spread_desc': {
                        const aSpread = (Number(a.getAttribute('data-max-price')) || 0) - (Number(a.getAttribute('data-min-price')) || 0);
                        const bSpread = (Number(b.getAttribute('data-max-price')) || 0) - (Number(b.getAttribute('data-min-price')) || 0);
                        return bSpread - aSpread;
                    }
                    default: return bPrice - aPrice;
                }
            });

            rows.forEach(r => tbody.appendChild(r));
            filterTableLocally();
        }

        // Update all UI cards, charts, and tables from returned payload
        function updateUIWithData(data) {
            const { analytics, records, reporting_date, fetched_at, from_cache } = data;

            // Update status bar
            document.getElementById('displayReportDate').innerText = reporting_date || 'Latest Available';
            document.getElementById('displayFetchedAt').innerText = fetched_at ? new Date(fetched_at).toLocaleTimeString('en-IN') : 'Just now';
            
            const dot = document.getElementById('statusDot');
            dot.className = `status-dot ${from_cache ? 'cached' : 'live'}`;

            const cacheContainer = document.getElementById('cacheBadgeContainer');
            if (from_cache) {
                cacheContainer.innerHTML = `<span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="fas fa-bolt me-1"></i> Cached (TTL: 15m)</span>`;
            } else {
                cacheContainer.innerHTML = `<span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fas fa-circle-check me-1"></i> Verified Live Feed</span>`;
            }

            // Update Table records counter
            document.getElementById('recordCounter').innerHTML = `Total Records: <strong>${records.length}</strong>`;

            // Update Table rows
            const tbody = document.getElementById('mandiTableBody');
            if (!records || records.length === 0) {
                tbody.innerHTML = `
                    <tr id="emptyTableRow">
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="fas fa-inbox fs-2 mb-2 d-block text-secondary"></i>
                            <h6>No government mandi records found for this criteria.</h6>
                            <p class="small text-muted mb-0">Try clearing price filters or selecting yesterday's date.</p>
                        </td>
                    </tr>
                `;
            } else {
                let html = '';
                records.forEach(row => {
                    const mspBadge = row.below_msp
                        ? `<span class="msp-badge-below"><i class="fas fa-triangle-exclamation me-1"></i> Below MSP</span>`
                        : `<span class="msp-badge-above"><i class="fas fa-circle-check me-1"></i> Above / Fair</span>`;

                    html += `
                        <tr data-market="${row.market.toLowerCase()}" 
                            data-state="${row.state.toLowerCase()}" 
                            data-district="${(row.district || '').toLowerCase()}"
                            data-variety="${row.variety.toLowerCase()}"
                            data-modal-price="${row.modal_price}"
                            data-min-price="${row.min_price}"
                            data-max-price="${row.max_price}"
                            data-arrivals="${row.arrivals}">
                            <td class="ps-3">
                                <div class="fw-bold text-dark">${row.market}</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">${row.district || row.state}</div>
                            </td>
                            <td><span class="text-secondary small fw-semibold">${row.state}</span></td>
                            <td>
                                <div class="fw-semibold text-dark">${row.commodity}</div>
                                <div class="badge bg-light text-secondary border fw-normal" style="font-size: 0.72rem;">${row.variety}</div>
                            </td>
                            <td>
                                <span class="fw-bold text-dark">${Number(row.arrivals).toLocaleString('en-IN')}</span>
                                <span class="text-muted small" style="font-size: 0.72rem;">${row.arrivals_unit}</span>
                            </td>
                            <td class="text-muted fw-semibold">₹${Number(row.min_price).toLocaleString('en-IN')}</td>
                            <td class="text-muted fw-semibold">₹${Number(row.max_price).toLocaleString('en-IN')}</td>
                            <td>
                                <span class="price-badge">₹${Number(row.modal_price).toLocaleString('en-IN')}</span>
                            </td>
                            <td>${mspBadge}</td>
                            <td class="pe-3 text-end">
                                <button class="btn btn-sm btn-outline-success rounded-pill px-3 fw-bold"
                                        onclick="showHistoricalPriceTrend('${row.commodity}', '${row.market}')">
                                    <i class="fas fa-chart-line me-1"></i> Trend
                                </button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            }

            // Update Arbitrage list
            const arbContainer = document.getElementById('arbitrageListContainer');
            if (analytics.market_comparisons && analytics.market_comparisons.length > 0) {
                let arbHtml = '';
                analytics.market_comparisons.slice(0, 6).forEach(item => {
                    let diffHtml = '';
                    if (item.diff_from_avg > 0) {
                        diffHtml = `<span class="text-success fw-bold" style="font-size: 0.72rem;"><i class="fas fa-arrow-up"></i> +₹${item.diff_from_avg} (+${item.pct_from_avg}%)</span>`;
                    } else if (item.diff_from_avg < 0) {
                        diffHtml = `<span class="text-danger fw-bold" style="font-size: 0.72rem;"><i class="fas fa-arrow-down"></i> -₹${Math.abs(item.diff_from_avg)} (${item.pct_from_avg}%)</span>`;
                    } else {
                        diffHtml = `<span class="text-muted fw-bold" style="font-size: 0.72rem;">Average Rate</span>`;
                    }

                    arbHtml += `
                        <div class="p-2 mb-2 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                            <div>
                                <div class="fw-bold text-dark small">${item.market}</div>
                                <div class="text-muted" style="font-size: 0.72rem;">${item.state} • ${item.variety}</div>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-dark">₹${Number(item.modal_price).toLocaleString('en-IN')}</div>
                                ${diffHtml}
                            </div>
                        </div>
                    `;
                });
                arbContainer.innerHTML = arbHtml;
            } else {
                arbContainer.innerHTML = '<div class="text-center py-4 text-muted small">No comparison data available.</div>';
            }

            filterTableLocally();
        }

        // Reset all filters to default
        function resetFilters() {
            document.getElementById('commoditySelect').value = 'Wheat';
            document.getElementById('stateSelect').value = '';
            document.getElementById('districtSelect').value = '';
            document.getElementById('districtSelect').disabled = true;
            document.getElementById('marketSelect').value = '';
            document.getElementById('marketSelect').disabled = true;
            document.getElementById('dateInput').value = '';
            document.getElementById('searchInput').value = '';
            document.getElementById('minPriceInput').value = '';
            document.getElementById('maxPriceInput').value = '';
            document.getElementById('sortBySelect').value = 'price_desc';

            document.querySelectorAll('.crop-chip').forEach(btn => {
                if (btn.innerText.trim().toLowerCase() === 'wheat') {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });

            document.querySelectorAll('.price-preset-chip').forEach((btn, idx) => {
                if (idx === 0) btn.classList.add('active');
                else btn.classList.remove('active');
            });

            applyFilters();
        }

        // Manual refresh button triggers fresh fetch bypass
        async function triggerManualRefresh() {
            const icon = document.getElementById('refreshIcon');
            icon.classList.add('fa-spin');
            await applyFilters();
            setTimeout(() => icon.classList.remove('fa-spin'), 600);
        }

        // Calculate Net Selling Realization
        function recalculateNetRealization() {
            if (!currentRawRecords || currentRawRecords.length === 0) return;

            const distanceKm = Number(document.getElementById('calcDistanceKm').value) || 25;
            const ratePerKm = Number(document.getElementById('calcRatePerKm').value) || 2.5;

            // Compute net realization for visible/current records
            const scored = currentRawRecords.map(r => {
                const freightCost = Math.round(distanceKm * ratePerKm);
                const netRealization = r.modal_price - freightCost;
                return { ...r, freightCost, netRealization };
            }).sort((a, b) => b.netRealization - a.netRealization);

            if (scored.length > 0) {
                const best = scored[0];
                document.getElementById('bestMandiName').innerText = `${best.market} (${best.state})`;
                document.getElementById('bestNetPrice').innerText = `₹${Number(best.netRealization).toLocaleString('en-IN')} / qtl`;
            }
        }

        // Show Historical Price Trend Modal
        async function showHistoricalPriceTrend(crop, market) {
            const modalTitle = document.getElementById('modalCropMarketTitle');
            const historyTbody = document.getElementById('modalHistoryTableBody');
            const trendBadge = document.getElementById('modalTrendBadge');
            const loadingOverlay = document.getElementById('chartLoadingOverlay');

            modalTitle.innerText = `${crop} — ${market}`;
            historyTbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Fetching verified records...</td></tr>';
            loadingOverlay.classList.remove('d-none');

            const modal = new bootstrap.Modal(document.getElementById('trendModal'));
            modal.show();

            try {
                const res = await fetch(`/api/market/history?crop=${encodeURIComponent(crop)}&market=${encodeURIComponent(market)}&days=5`);
                const data = await res.json();
                loadingOverlay.classList.add('d-none');

                if (data.success && data.history && data.history.length > 0) {
                    let tableHtml = '';
                    const labels = [];
                    const modalPrices = [];
                    const minPrices = [];
                    const maxPrices = [];

                    data.history.forEach(row => {
                        const trendIcon = row.trend === 'up'
                            ? `<span class="text-success fw-bold"><i class="fas fa-arrow-trend-up"></i> +₹${row.change} (${row.change_pct}%)</span>`
                            : (row.trend === 'down'
                                ? `<span class="text-danger fw-bold"><i class="fas fa-arrow-trend-down"></i> -₹${Math.abs(row.change)} (${row.change_pct}%)</span>`
                                : `<span class="text-muted fw-bold"><i class="fas fa-minus"></i> Stable</span>`);

                        tableHtml += `
                            <tr>
                                <td class="fw-bold">${row.display_date || row.date}</td>
                                <td class="text-muted small">${row.market}</td>
                                <td class="fw-bold text-success">₹${Number(row.price).toLocaleString('en-IN')}</td>
                                <td class="text-muted small">₹${Number(row.min).toLocaleString('en-IN')} - ₹${Number(row.max).toLocaleString('en-IN')}</td>
                                <td>${trendIcon}</td>
                            </tr>
                        `;
                    });
                    historyTbody.innerHTML = tableHtml;

                    // Compute overall trend badge
                    const latest = data.history[0];
                    const oldest = data.history[data.history.length - 1];
                    const totalChange = latest.price - oldest.price;
                    const totalPct = oldest.price > 0 ? ((totalChange / oldest.price) * 100).toFixed(1) : 0;

                    if (totalChange > 0) {
                        trendBadge.className = 'badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill';
                        trendBadge.innerHTML = `<i class="fas fa-arrow-trend-up me-1"></i> Rising Trend (+${totalPct}%)`;
                    } else if (totalChange < 0) {
                        trendBadge.className = 'badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill';
                        trendBadge.innerHTML = `<i class="fas fa-arrow-trend-down me-1"></i> Falling Trend (${totalPct}%)`;
                    } else {
                        trendBadge.className = 'badge bg-secondary-subtle text-secondary border px-3 py-2 rounded-pill';
                        trendBadge.innerHTML = `<i class="fas fa-minus me-1"></i> Stable Trend (0%)`;
                    }

                    // Render Chart.js
                    const chartData = [...data.history].reverse();
                    chartData.forEach(h => {
                        labels.push(h.display_date || h.date);
                        modalPrices.push(h.price);
                        minPrices.push(h.min);
                        maxPrices.push(h.max);
                    });

                    renderTrendChart(labels, modalPrices, minPrices, maxPrices);
                } else {
                    historyTbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">No historical data available for this market center.</td></tr>';
                }
            } catch (err) {
                console.error('History fetch error:', err);
                loadingOverlay.classList.add('d-none');
                historyTbody.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-danger">Failed to load historical rates.</td></tr>';
            }
        }

        // Render Chart.js instance
        function renderTrendChart(labels, modalPrices, minPrices, maxPrices) {
            const ctx = document.getElementById('historicalChartCanvas').getContext('2d');
            if (chartInstance) {
                chartInstance.destroy();
            }

            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels,
                    datasets: [
                        {
                            label: 'Modal Price (₹/qtl)',
                            data: modalPrices,
                            borderColor: '#10b981',
                            backgroundColor: 'rgba(16, 185, 129, 0.1)',
                            fill: true,
                            tension: 0.3,
                            borderWidth: 3,
                            pointRadius: 5,
                            pointBackgroundColor: '#10b981'
                        },
                        {
                            label: 'Max Price (₹/qtl)',
                            data: maxPrices,
                            borderColor: '#3b82f6',
                            borderDash: [5, 5],
                            tension: 0.3,
                            borderWidth: 1.5,
                            pointRadius: 3
                        },
                        {
                            label: 'Min Price (₹/qtl)',
                            data: minPrices,
                            borderColor: '#f59e0b',
                            borderDash: [5, 5],
                            tension: 0.3,
                            borderWidth: 1.5,
                            pointRadius: 3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: {
                                font: { family: 'Plus Jakarta Sans', size: 12 }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.dataset.label}: ₹${context.parsed.y.toLocaleString('en-IN')}`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            ticks: {
                                callback: function(value) { return '₹' + value; },
                                font: { family: 'Plus Jakarta Sans', size: 11 }
                            },
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            ticks: { font: { family: 'Plus Jakarta Sans', size: 11 } },
                            grid: { display: false }
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>
