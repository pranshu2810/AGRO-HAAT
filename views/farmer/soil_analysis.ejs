});

// Add Plot Modal Form Submit
document.getElementById('newPlotForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('savePlotModalSubmitBtn');
    btn.disabled = true;

    const modalDistSelect = document.getElementById('modal_district');
    const modalCustomDist = document.getElementById('modal_custom_district');
    const actualModalDistrict = (modalDistSelect.value === '__custom__' || !modalDistSelect.value)
        ? (modalCustomDist.value.trim() || 'Central District')
        : modalDistSelect.value;

    const payload = {
        plot_name: document.getElementById('modal_plot_name').value,
        area_acres: document.getElementById('modal_area_acres').value,
        survey_number: document.getElementById('modal_survey_no').value,
        state: document.getElementById('modal_state').value,
        district: actualModalDistrict,
        block_tehsil: document.getElementById('modal_block').value,
        village: document.getElementById('modal_village').value,
        soil_type: document.getElementById('modal_soil_type').value
    };

    try {
        const res = await fetch('/api/soil/plots', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            bootstrap.Modal.getInstance(document.getElementById('addPlotModal')).hide();
            // Populate form
            document.getElementById('plot_name').value = data.plot.plot_name;
            document.getElementById('area_acres').value = data.plot.area_acres;
            document.getElementById('stateSelect').value = data.plot.state;
            updateDistrictDropdown(data.plot.state, data.plot.district);
            document.getElementById('block_tehsil').value = data.plot.block_tehsil;
            document.getElementById('village').value = data.plot.village;

            const opt = document.createElement('option');
            opt.value = data.plot.id;
            opt.textContent = `${data.plot.plot_name} (${data.plot.district} - ${data.plot.area_acres} Acres)`;
            opt.selected = true;
            document.getElementById('savedPlotSelect').appendChild(opt);
        } else {
            document.getElementById('modalPlotError').textContent = data.error || 'Failed to save plot';
            document.getElementById('modalPlotError').classList.remove('d-none');
        }
    } catch (err) {
        document.getElementById('modalPlotError').textContent = err.message;
        document.getElementById('modalPlotError').classList.remove('d-none');
    }
    btn.disabled = false;
});

// ================= RUN ANALYSIS =================
document.getElementById('runAnalysisBtn').addEventListener('click', async () => {
    const errBox = document.getElementById('formValidationErrors');
    errBox.classList.add('d-none');
    errBox.innerHTML = '';

    const getSelectedDistrict = () => {
        const select = document.getElementById('districtSelect');
        const custom = document.getElementById('customDistrictInput');
        if (select.value === '__custom__' || !select.value) {
            return custom.value.trim() || 'Central District';
        }
        return select.value;
    };

    const payload = {
        plot_name: document.getElementById('plot_name').value,
        area_acres: document.getElementById('area_acres').value,
        state: document.getElementById('stateSelect').value,
        district: getSelectedDistrict(),
        block_tehsil: document.getElementById('block_tehsil').value,
        village: document.getElementById('village').value,
        latitude: document.getElementById('latitude').value,
        longitude: document.getElementById('longitude').value,
        soil_type: document.getElementById('soil_type').value,
        data_source: document.getElementById('data_source').value,
        shc_sample_number: document.getElementById('shc_sample_number').value,
        n_value: document.getElementById('n_value').value,
        n_unit: document.getElementById('n_unit').value,
        p_value: document.getElementById('p_value').value,
        p_unit: document.getElementById('p_unit').value,
        k_value: document.getElementById('k_value').value,
        k_unit: document.getElementById('k_unit').value,
        ph_value: document.getElementById('ph_value').value,
        ec_value: document.getElementById('ec_value').value,
        oc_value: document.getElementById('oc_value').value,
        s_value: document.getElementById('s_value').value,
        zn_value: document.getElementById('zn_value').value,
        fe_value: document.getElementById('fe_value').value,
        b_value: document.getElementById('b_value').value,
        cu_value: document.getElementById('cu_value').value,
        mn_value: document.getElementById('mn_value').value,
        crop_name: document.getElementById('crop_name').value,
        season: document.getElementById('season').value,
        growth_stage: document.getElementById('growth_stage').value,
        irrigation_type: document.getElementById('irrigation_type').value,
        sample_depth: document.getElementById('sample_depth').value,
        target_yield: document.getElementById('target_yield').value
    };

    // UI Loading state
    const runBtn = document.getElementById('runAnalysisBtn');
    runBtn.disabled = true;
    runBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Analyzing Soil Health...';

    document.getElementById('reportPlaceholder').classList.add('d-none');
    document.getElementById('reportContainer').classList.add('d-none');
    document.getElementById('analysisLoading').classList.remove('d-none');

    try {
        const response = await fetch('/api/soil/analyze', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });

        const data = await response.json();

        if (!data.success) {
            document.getElementById('analysisLoading').classList.add('d-none');
            document.getElementById('reportPlaceholder').classList.remove('d-none');
            errBox.innerHTML = `<strong>Validation Error:</strong><br>${(data.errors || [data.error]).join('<br>')}`;
            errBox.classList.remove('d-none');
            runBtn.disabled = false;
            runBtn.innerHTML = '<i class="fas fa-flask me-2"></i> Run Scientific Soil Health Analysis';
            return;
        }

        // Render full bilingual report
        renderBilingualReport(data.assessment, data.ai_explanation);

        document.getElementById('analysisLoading').classList.add('d-none');
        document.getElementById('reportContainer').classList.remove('d-none');

    } catch (err) {
        document.getElementById('analysisLoading').classList.add('d-none');
        document.getElementById('reportPlaceholder').classList.remove('d-none');
        errBox.innerHTML = `<strong>Server Connection Error:</strong> ${err.message}`;
        errBox.classList.remove('d-none');
    }

    runBtn.disabled = false;
    runBtn.innerHTML = '<i class="fas fa-flask me-2"></i> Run Scientific Soil Health Analysis';
});

// Render Bilingual Report in UI
function renderBilingualReport(ass, ai) {
    // 1. ENGLISH REPORT
    document.getElementById('repPlotNameEn').textContent = ass.farm_details.plot_name;
    document.getElementById('repLocationEn').textContent = `${ass.farm_details.village}, ${ass.farm_details.district}, ${ass.farm_details.state} (${ass.farm_details.coordinates})`;
    document.getElementById('repRatingEn').textContent = ass.fertility_index.rating_en;
    document.getElementById('repScoreEn').textContent = `Fertility Index: ${ass.fertility_index.score}/100`;

    document.getElementById('repCropEn').textContent = ass.crop_context.crop_name_en;
    document.getElementById('repAreaEn').textContent = `${ass.farm_details.area_acres} Acres (${ass.farm_details.area_hectares} ha)`;
    document.getElementById('repSoilTypeEn').textContent = ass.farm_details.soil_texture;
    document.getElementById('repDepthEn').textContent = ass.farm_details.sample_depth;
    document.getElementById('repDateEn').textContent = ass.farm_details.sample_date;
    document.getElementById('repSourceEn').textContent = ass.farm_details.data_source;

    // AI Summary
    document.getElementById('aiSummaryEn').textContent = ai.summary_en || 'Assessment generated based on ICAR standards.';

    // Nutrient badges helper
    const setNutrient = (valId, badgeId, reasonId, item, isPh = false) => {
        if (!item) return;
        const valEl = document.getElementById(valId);
        const badgeEl = document.getElementById(badgeId);
        const reasonEl = document.getElementById(reasonId);

        valEl.textContent = isPh ? item.ph_value : `${item.value_kg_ha || item.value} ${item.raw_unit || item.unit}`;
        badgeEl.textContent = item.classification;

        if (item.classification === 'Low' || item.classification.includes('Acidic') || item.classification.includes('Sodic')) {
            badgeEl.className = 'badge bg-danger rounded-pill px-2 py-1 mb-2';
        } else if (item.classification === 'Medium' || item.classification.includes('Neutral') || item.classification === 'Sufficient') {
            badgeEl.className = 'badge bg-success rounded-pill px-2 py-1 mb-2';
        } else {
            badgeEl.className = 'badge bg-primary rounded-pill px-2 py-1 mb-2';
        }

        reasonEl.textContent = item.reason_en || item.description_en || '';
    };

    setNutrient('valNEn', 'badgeNEn', 'reasonNEn', ass.nutrients.n);
    setNutrient('valPEn', 'badgePEn', 'reasonPEn', ass.nutrients.p);
    setNutrient('valKEn', 'badgeKEn', 'reasonKEn', ass.nutrients.k);
    setNutrient('valPhEn', 'badgePhEn', 'reasonPhEn', ass.soil_reaction, true);

    // Optional Nutrients Grid
    const optGridEn = document.getElementById('optionalNutrientsGridEn');
    optGridEn.innerHTML = '';
    let hasOpt = false;
    ['ec', 'oc', 's', 'zn', 'fe', 'b', 'cu', 'mn'].forEach(key => {
        if (ass.nutrients[key]) {
            hasOpt = true;
            const nut = ass.nutrients[key];
            const col = document.createElement('div');
            col.className = 'col-sm-6 col-md-3';
            col.innerHTML = `
                <div class="p-2 bg-light rounded-3 border text-center">
                    <small class="d-block text-muted">${nut.name_en}</small>
                    <strong class="d-block text-dark">${nut.value} ${nut.unit}</strong>
                    <span class="badge ${nut.classification === 'Deficient' ? 'bg-danger' : 'bg-success'} rounded-pill" style="font-size: 0.65rem;">
                        ${nut.classification}
                    </span>
                </div>
            `;
            optGridEn.appendChild(col);
        }
    });
    if (hasOpt) document.getElementById('optionalNutrientsSecEn').classList.remove('d-none');

    // Fertilizer Table EN
    const fertTbodyEn = document.getElementById('fertilizerTableEn');
    fertTbodyEn.innerHTML = '';
    ass.fertilizer_recommendations.commercial_products_per_acre.forEach(p => {
        const total = Math.round(p.quantity_kg * ass.farm_details.area_acres);
        const row = document.createElement('tr');
        row.innerHTML = `
            <td><strong>${p.product_en}</strong></td>
            <td>${p.quantity_kg} kg/acre <br><span class="text-muted" style="font-size:0.75rem;">(${p.bags})</span></td>
            <td><strong>${total} kg</strong> for ${ass.farm_details.area_acres} acres</td>
            <td>${p.stage_en}</td>
        `;
        fertTbodyEn.appendChild(row);
    });

    // Amendments EN
    const amdListEn = document.getElementById('amendmentsListEn');
    amdListEn.innerHTML = '';
    if (ass.soil_amendments && ass.soil_amendments.length > 0) {
        ass.soil_amendments.forEach(a => {
            const li = document.createElement('li');
            li.innerHTML = `<strong>${a.amendment_en}:</strong> ${a.dosage_acre} (${a.application_timing_en})`;
            amdListEn.appendChild(li);
        });
        document.getElementById('amendmentsSecEn').classList.remove('d-none');
    } else {
        document.getElementById('amendmentsSecEn').classList.add('d-none');
    }

    // Next Steps EN
    const stepsEn = document.getElementById('nextStepsListEn');
    stepsEn.innerHTML = '';
    ass.practical_next_steps.en.forEach(step => {
        const li = document.createElement('li');
        li.className = 'mb-1';
        li.textContent = step;
        stepsEn.appendChild(li);
    });

    // FAQs EN
    const faqsEn = document.getElementById('faqsListEn');
    faqsEn.innerHTML = '';
    if (ai.faqs && ai.faqs.length > 0) {
        ai.faqs.forEach(f => {
            const item = document.createElement('div');
            item.className = 'mb-2 p-2 bg-white rounded-3 border';
            item.innerHTML = `<strong><i class="fas fa-question text-info me-1"></i> ${f.q_en}</strong><p class="text-muted mb-0 mt-1">${f.a_en}</p>`;
            faqsEn.appendChild(item);
        });
    }

    // 2. HINDI REPORT
    document.getElementById('repPlotNameHi').textContent = ass.farm_details.plot_name;
    document.getElementById('repLocationHi').textContent = `${ass.farm_details.village}, ${ass.farm_details.district}, ${ass.farm_details.state}`;
    document.getElementById('repRatingHi').textContent = ass.fertility_index.rating_hi;
    document.getElementById('repScoreHi').textContent = `उर्वरता स्कोर: ${ass.fertility_index.score}/100`;

    document.getElementById('repCropHi').textContent = ass.crop_context.crop_name_hi;
    document.getElementById('repAreaHi').textContent = `${ass.farm_details.area_acres} एकड़ (${ass.farm_details.area_hectares} हेक्टेयर)`;
    document.getElementById('repSoilTypeHi').textContent = ass.farm_details.soil_texture;
    document.getElementById('repDepthHi').textContent = ass.farm_details.sample_depth;
    document.getElementById('repDateHi').textContent = ass.farm_details.sample_date;
    document.getElementById('repSourceHi').textContent = ass.farm_details.data_source;

    // AI Summary HI
    document.getElementById('aiSummaryHi').textContent = ai.summary_hi || 'आईसीएआर वैज्ञानिक मानकों के अनुसार गणना की गई।';

    // Nutrient badges helper HI
    const setNutrientHi = (valId, badgeId, reasonId, item, isPh = false) => {
        if (!item) return;
        const valEl = document.getElementById(valId);
        const badgeEl = document.getElementById(badgeId);
        const reasonEl = document.getElementById(reasonId);

        valEl.textContent = isPh ? item.ph_value : `${item.value_kg_ha || item.value} ${item.raw_unit || item.unit}`;
        badgeEl.textContent = item.classification === 'Low' ? 'कम (Low)' : (item.classification === 'Medium' ? 'मध्यम (Medium)' : 'उच्च (High)');

        if (item.classification === 'Low' || item.classification.includes('Acidic') || item.classification.includes('Sodic')) {
            badgeEl.className = 'badge bg-danger rounded-pill px-2 py-1 mb-2';
        } else if (item.classification === 'Medium' || item.classification.includes('Neutral') || item.classification === 'Sufficient') {
            badgeEl.className = 'badge bg-success rounded-pill px-2 py-1 mb-2';
        } else {
            badgeEl.className = 'badge bg-primary rounded-pill px-2 py-1 mb-2';
        }

        reasonEl.textContent = item.reason_hi || item.description_hi || '';
    };

    setNutrientHi('valNHi', 'badgeNHi', 'reasonNHi', ass.nutrients.n);
    setNutrientHi('valPHi', 'badgePHi', 'reasonPHi', ass.nutrients.p);
    setNutrientHi('valKHi', 'badgeKHi', 'reasonKHi', ass.nutrients.k);
    setNutrientHi('valPhHi', 'badgePhHi', 'reasonPhHi', ass.soil_reaction, true);

    // Optional Nutrients Grid HI
    const optGridHi = document.getElementById('optionalNutrientsGridHi');
    optGridHi.innerHTML = '';
    ['ec', 'oc', 's', 'zn', 'fe', 'b', 'cu', 'mn'].forEach(key => {
        if (ass.nutrients[key]) {
            const nut = ass.nutrients[key];
            const col = document.createElement('div');
            col.className = 'col-sm-6 col-md-3';
            col.innerHTML = `
                <div class="p-2 bg-light rounded-3 border text-center">
                    <small class="d-block text-muted">${nut.name_hi}</small>
                    <strong class="d-block text-dark">${nut.value} ${nut.unit}</strong>
                    <span class="badge ${nut.classification === 'Deficient' ? 'bg-danger' : 'bg-success'} rounded-pill" style="font-size: 0.65rem;">
                        ${nut.classification === 'Deficient' ? 'कमी (Deficient)' : 'पर्याप्त (Sufficient)'}
                    </span>
                </div>
            `;
            optGridHi.appendChild(col);
        }
    });
    if (hasOpt) document.getElementById('optionalNutrientsSecHi').classList.remove('d-none');

    // Fertilizer Table HI
    const fertTbodyHi = document.getElementById('fertilizerTableHi');
    fertTbodyHi.innerHTML = '';
    ass.fertilizer_recommendations.commercial_products_per_acre.forEach(p => {
        const total = Math.round(p.quantity_kg * ass.farm_details.area_acres);
        const row = document.createElement('tr');
        row.innerHTML = `
            <td><strong>${p.product_hi}</strong></td>
            <td>${p.quantity_kg} किग्रा/एकड़</td>
            <td><strong>${total} किग्रा</strong> (${ass.farm_details.area_acres} एकड़)</td>
            <td>${p.stage_hi}</td>
        `;
        fertTbodyHi.appendChild(row);
    });

    // Amendments HI
    const amdListHi = document.getElementById('amendmentsListHi');
    amdListHi.innerHTML = '';
    if (ass.soil_amendments && ass.soil_amendments.length > 0) {
        ass.soil_amendments.forEach(a => {
            const li = document.createElement('li');
            li.innerHTML = `<strong>${a.amendment_hi}:</strong> ${a.dosage_acre} (${a.application_timing_hi})`;
            amdListHi.appendChild(li);
        });
        document.getElementById('amendmentsSecHi').classList.remove('d-none');
    } else {
        document.getElementById('amendmentsSecHi').classList.add('d-none');
    }

    // Next Steps HI
    const stepsHi = document.getElementById('nextStepsListHi');
    stepsHi.innerHTML = '';
    ass.practical_next_steps.hi.forEach(step => {
        const li = document.createElement('li');
        li.className = 'mb-1';
        li.textContent = step;
        stepsHi.appendChild(li);
    });

    // FAQs HI
    const faqsHi = document.getElementById('faqsListHi');
    faqsHi.innerHTML = '';
    if (ai.faqs && ai.faqs.length > 0) {
        ai.faqs.forEach(f => {
            const item = document.createElement('div');
            item.className = 'mb-2 p-2 bg-white rounded-3 border';
            item.innerHTML = `<strong><i class="fas fa-question text-info me-1"></i> ${f.q_hi}</strong><p class="text-muted mb-0 mt-1">${f.a_hi}</p>`;
            faqsHi.appendChild(item);
        });
    }

    // Scroll smoothly to report
    document.getElementById('reportContainer').scrollIntoView({ behavior: 'smooth' });
}

// History load button
document.querySelectorAll('.loadHistoryBtn').forEach(btn => {
    btn.addEventListener('click', async (e) => {
        const recId = e.currentTarget.dataset.id;
        try {
            const res = await fetch(`/api/soil/record/${recId}`);
            const data = await res.json();
            if (data.success && data.record && data.record.analysis) {
                renderBilingualReport(data.record.analysis.assessment, data.record.analysis.ai_explanation);
                document.getElementById('reportPlaceholder').classList.add('d-none');
                document.getElementById('reportContainer').classList.remove('d-none');
            }
        } catch (err) {
            alert('Could not load history record: ' + err.message);
        }
    });
});

// Copy Summary
document.getElementById('copySummaryBtn').addEventListener('click', () => {
    const textEn = document.getElementById('aiSummaryEn').textContent;
    const textHi = document.getElementById('aiSummaryHi').textContent;
    navigator.clipboard.writeText(`[AgroHaat Soil Health Card Report]\nEN: ${textEn}\nHI: ${textHi}`);
    alert('Report summary copied to clipboard!');
});
</script>

