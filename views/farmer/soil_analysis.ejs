</div>

<!-- ================= JAVASCRIPT LOGIC ================= -->
<script>
// State to District Mapping Directory (All 28 States and 8 Union Territories)
const REGION_DATA = <%- JSON.stringify(typeof regionHierarchy !== 'undefined' ? regionHierarchy : {}) %>;

// Populate Districts based on selected State
function updateDistrictDropdown(selectedState, selectedDistrict = '') {
    const districtSelect = document.getElementById('districtSelect');
    const customInput = document.getElementById('customDistrictInput');
    districtSelect.innerHTML = '<option value="">-- Select District --</option>';
    
    let matched = false;
    if (selectedState && REGION_DATA[selectedState]) {
        const districts = (REGION_DATA[selectedState].districts || []).slice().sort();
        districts.forEach(d => {
            const opt = document.createElement('option');
            opt.value = d;
            opt.textContent = d;
            if (selectedDistrict && d.toLowerCase() === selectedDistrict.toLowerCase()) {
                opt.selected = true;
                matched = true;
            } else if (!selectedDistrict && d === districts[0]) {
                opt.selected = true;
                matched = true;
            }
            districtSelect.appendChild(opt);
        });
    }

    // Always add Custom District option
    const customOpt = document.createElement('option');
    customOpt.value = '__custom__';
    customOpt.textContent = '✏️ Other / Enter Custom District...';
    districtSelect.appendChild(customOpt);

    if (selectedDistrict && !matched) {
        customOpt.selected = true;
        customInput.value = selectedDistrict;
        customInput.classList.remove('d-none');
    } else if (districtSelect.value !== '__custom__') {
        customInput.classList.add('d-none');
    }
}

// Update Modal District Dropdown
function updateModalDistrictDropdown(selectedState, selectedDistrict = '') {
    const modalDistrict = document.getElementById('modal_district');
    const modalCustomInput = document.getElementById('modal_custom_district');
    if (!modalDistrict) return;
    modalDistrict.innerHTML = '<option value="">-- Select District --</option>';

    let matched = false;
    if (selectedState && REGION_DATA[selectedState]) {
        const districts = (REGION_DATA[selectedState].districts || []).slice().sort();
        districts.forEach(d => {
            const opt = document.createElement('option');
            opt.value = d;
            opt.textContent = d;
            if (selectedDistrict && d.toLowerCase() === selectedDistrict.toLowerCase()) {
                opt.selected = true;
                matched = true;
            }
            modalDistrict.appendChild(opt);
        });
    }
    const customOpt = document.createElement('option');
    customOpt.value = '__custom__';
    customOpt.textContent = '✏️ Other / Enter Custom District...';
    modalDistrict.appendChild(customOpt);

    if (selectedDistrict && !matched) {
        customOpt.selected = true;
        if (modalCustomInput) {
            modalCustomInput.value = selectedDistrict;
            modalCustomInput.classList.remove('d-none');
        }
    } else if (modalDistrict.value !== '__custom__' && modalCustomInput) {
        modalCustomInput.classList.add('d-none');
    }
}

// Initialize on DOM load
document.addEventListener('DOMContentLoaded', () => {
    const stateSelect = document.getElementById('stateSelect');
    updateDistrictDropdown(stateSelect.value, 'Lucknow');

    stateSelect.addEventListener('change', (e) => {
        updateDistrictDropdown(e.target.value);
    });

    const districtSelect = document.getElementById('districtSelect');
    const customDistrictInput = document.getElementById('customDistrictInput');
    districtSelect.addEventListener('change', (e) => {
        if (e.target.value === '__custom__') {
            customDistrictInput.classList.remove('d-none');
            customDistrictInput.focus();
        } else {
            customDistrictInput.classList.add('d-none');
        }
    });

    const toggleCustomBtn = document.getElementById('toggleCustomDistrictBtn');
    if (toggleCustomBtn) {
        toggleCustomBtn.addEventListener('click', () => {
            districtSelect.value = '__custom__';
            customDistrictInput.classList.remove('d-none');
            customDistrictInput.focus();
        });
    }

    // Modal state listener
    const modalState = document.getElementById('modal_state');
    if (modalState) {
        updateModalDistrictDropdown(modalState.value, 'Lucknow');
        modalState.addEventListener('change', (e) => {
            updateModalDistrictDropdown(e.target.value);
        });
    }

    const modalDistrict = document.getElementById('modal_district');
    const modalCustomInput = document.getElementById('modal_custom_district');
    if (modalDistrict && modalCustomInput) {
        modalDistrict.addEventListener('change', (e) => {
            if (e.target.value === '__custom__') {
                modalCustomInput.classList.remove('d-none');
                modalCustomInput.focus();
            } else {
                modalCustomInput.classList.add('d-none');
            }
        });
    }

    // Saved plot selector change handler
    const savedPlotSelect = document.getElementById('savedPlotSelect');
    savedPlotSelect.addEventListener('change', (e) => {
        const opt = e.target.selectedOptions[0];
        if (!opt || !opt.value) return;

        document.getElementById('plot_name').value = opt.dataset.name || '';
        document.getElementById('area_acres').value = opt.dataset.area || '1.0';
        document.getElementById('block_tehsil').value = opt.dataset.block || '';
        document.getElementById('village').value = opt.dataset.village || '';
        document.getElementById('latitude').value = opt.dataset.lat || '';
        document.getElementById('longitude').value = opt.dataset.lon || '';
        document.getElementById('soil_type').value = opt.dataset.soil || 'Loamy Soil';

        if (opt.dataset.state) {
            document.getElementById('stateSelect').value = opt.dataset.state;
            updateDistrictDropdown(opt.dataset.state, opt.dataset.district);
        }
    });

    document.getElementById('clearPlotBtn').addEventListener('click', () => {
        savedPlotSelect.value = '';
        document.getElementById('plot_name').value = 'New Farm Plot';
        document.getElementById('area_acres').value = '1.0';
    });
});

// GPS Auto Detection
document.getElementById('detectGpsBtn').addEventListener('click', () => {
    const statusBadge = document.getElementById('gpsStatusBadge');
    const alertBox = document.getElementById('gpsAlert');
    const btn = document.getElementById('detectGpsBtn');

    if (!navigator.geolocation) {
        alertBox.className = 'small mt-2 alert alert-danger p-2 rounded-3';
        alertBox.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i> Geolocation is not supported by your browser.';
        alertBox.classList.remove('d-none');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Detecting GPS...';
    statusBadge.className = 'badge bg-warning text-dark rounded-pill px-2';
    statusBadge.textContent = 'Acquiring GPS';

    navigator.geolocation.getCurrentPosition(
        async (position) => {
            const lat = position.coords.latitude;
            const lon = position.coords.longitude;
            const acc = Math.round(position.coords.accuracy || 10);

            document.getElementById('latitude').value = lat.toFixed(6);
            document.getElementById('longitude').value = lon.toFixed(6);

            statusBadge.className = 'badge bg-info text-white rounded-pill px-2';
            statusBadge.textContent = 'Geocoding...';

            try {
                const res = await fetch('/api/soil/reverse-geocode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ latitude: lat, longitude: lon })
                });
                const loc = await res.json();

                if (loc.state) {
                    const stSelect = document.getElementById('stateSelect');
                    stSelect.value = loc.state;
                    updateDistrictDropdown(loc.state, loc.district);
                }
                if (loc.block) document.getElementById('block_tehsil').value = loc.block;
                if (loc.village) document.getElementById('village').value = loc.village;

                statusBadge.className = 'badge bg-success text-white rounded-pill px-2';
                statusBadge.textContent = 'GPS Locked';

                alertBox.className = 'small mt-2 alert alert-success p-2 rounded-3';
                alertBox.innerHTML = `<i class="fas fa-check-circle me-1"></i> GPS Detected: <strong>${loc.village || ''}, ${loc.district}, ${loc.state}</strong> (Accuracy: ±${acc}m)`;
                alertBox.classList.remove('d-none');
            } catch (e) {
                statusBadge.className = 'badge bg-success text-white rounded-pill px-2';
                statusBadge.textContent = 'Coordinates Set';
            }

            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Re-detect GPS';
        },
        (error) => {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-crosshairs me-1"></i> Detect Current GPS Location';
            statusBadge.className = 'badge bg-danger text-white rounded-pill px-2';
            statusBadge.textContent = 'GPS Failed';

            let msg = 'Could not acquire GPS coordinates.';
            if (error.code === error.PERMISSION_DENIED) {
                msg = 'Location permission was denied in your browser. Please select your State and District manually above.';
            } else if (error.code === error.TIMEOUT) {
                msg = 'GPS acquisition timed out. Please enter manual coordinates or select your district.';
            }

            alertBox.className = 'small mt-2 alert alert-warning p-2 rounded-3';
            alertBox.innerHTML = `<i class="fas fa-exclamation-circle me-1"></i> ${msg}`;
            alertBox.classList.remove('d-none');
        },
        { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
    );
});

// Quick Save Plot to DB
// Quick Save Plot to DB
document.getElementById('quickSavePlotBtn').addEventListener('click', async () => {
    const distSelect = document.getElementById('districtSelect');
    const customDist = document.getElementById('customDistrictInput');
    const actualDistrict = (distSelect.value === '__custom__' || !distSelect.value)
        ? (customDist.value.trim() || 'Central District')
        : distSelect.value;

    const payload = {
        plot_name: document.getElementById('plot_name').value || 'My Farm Plot',
        area_acres: document.getElementById('area_acres').value || 1.0,
        state: document.getElementById('stateSelect').value || 'Uttar Pradesh',
        district: actualDistrict,
        block_tehsil: document.getElementById('block_tehsil').value || 'Sadar',
        village: document.getElementById('village').value || 'Village',
        latitude: document.getElementById('latitude').value || null,
        longitude: document.getElementById('longitude').value || null,
        soil_type: document.getElementById('soil_type').value || 'Loamy Soil'
    };

    try {
        const res = await fetch('/api/soil/plots', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            const msg = document.getElementById('plotSaveMsg');
            msg.classList.remove('d-none');
            setTimeout(() => msg.classList.add('d-none'), 3000);

            // Add to dropdown
            const opt = document.createElement('option');
            opt.value = data.plot.id;
            opt.textContent = `${data.plot.plot_name} (${data.plot.district} - ${data.plot.area_acres} Acres)`;
            opt.selected = true;
            document.getElementById('savedPlotSelect').appendChild(opt);
        }
    } catch (e) {
        alert('Could not save plot: ' + e.message);
