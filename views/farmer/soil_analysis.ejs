    body * {
        visibility: hidden;
    }
    .printable-report, .printable-report * {
        visibility: visible;
    }
    .printable-report {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
    }
    .navbar-farmer-wrapper, #detectGpsBtn, .btn, #langTabs {
        display: none !important;
    }
}
