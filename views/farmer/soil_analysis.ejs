<%- include('../partials/header', { page_title: 'Soil Health Analysis & Intelligence' }) %>
<%- include('../partials/navbar_farmer') %>

<div class="container-fluid px-lg-5 mt-4 mb-5">
    <!-- Top Header Banner -->
    <div class="glass-card p-4 mb-4 border-start border-4 border-success animate-fade-in-up">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="d-flex align-items-center mb-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill me-2">
                        <i class="fas fa-microscope me-1"></i> ICAR & GoI SHC Standards v1.35
                    </span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                        <i class="fas fa-language me-1"></i> Bilingual (English & हिंदी)
                    </span>
                </div>
                <h2 class="fw-bold text-dark mb-1">
                    Smart Soil Health Intelligence & Advisory 🧪🌾
                </h2>
                <p class="text-muted mb-0 small">
                    Location-aware, scientifically-calibrated soil assessment based on ICAR fertility ratings, SAU General Fertilizer Recommendations (GFR), and official GoI Soil Health Card protocols.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                <button class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#shcApiModal">
                    <i class="fas fa-link me-1"></i> GoI SHC API Status
                </button>
                <button class="btn btn-success btn-sm rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#addPlotModal">
                    <i class="fas fa-plus-circle me-1"></i> Add / Save Plot
                </button>
            </div>
        </div>
    </div>

    <!-- Location Disclaimer Alert -->
    <div class="alert alert-info border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-center">
        <i class="fas fa-info-circle fa-2x text-primary me-3"></i>
        <div class="small">
            <strong>Scientific Advisory:</strong> Farm location GPS is used strictly to identify your administrative agro-climatic region, soil texture zone, and regional GFR guidance. 
            <span class="text-danger fw-semibold">Soil nutrient values are never inferred from GPS alone</span>; they must be provided from certified laboratory tests, Soil Health Cards, or field test kits.
        </div>
    </div>

    <div class="row g-4">
        <!-- LEFT COLUMN: Workflow Input Forms -->
        <div class="col-xl-5 col-lg-6">
            <div class="glass-card p-4 shadow-sm mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fas fa-map-marked-alt text-success me-2"></i>Step 1: Farm Location & Plot Profile
                </h5>

                <!-- Saved Plot Selector -->
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted">Select Saved Plot (खेत चुनें)</label>
                    <div class="input-group">
                        <select id="savedPlotSelect" class="form-select rounded-start-pill">
                            <option value="">-- Choose from saved farm plots (or enter below) --</option>
                            <% if (typeof savedPlots !== 'undefined' && savedPlots.length > 0) { %>
                                <% savedPlots.forEach(plot => { %>
                                    <option value="<%= plot.id %>" 
                                            data-name="<%= plot.plot_name %>"
                                            data-area="<%= plot.area_acres %>"
                                            data-state="<%= plot.state %>"
                                            data-district="<%= plot.district %>"
                                            data-block="<%= plot.block_tehsil %>"
                                            data-village="<%= plot.village %>"
                                            data-lat="<%= plot.latitude %>"
                                            data-lon="<%= plot.longitude %>"
                                            data-soil="<%= plot.soil_type %>"
                                            data-survey="<%= plot.survey_number %>">
                                        <%= plot.plot_name %> (<%= plot.district %>, <%= plot.state %> - <%= plot.area_acres %> Acres)
                                    </option>
                                <% }); %>
                            <% } %>
                        </select>
                        <button type="button" class="btn btn-outline-secondary rounded-end-pill px-3" id="clearPlotBtn" title="Clear / New Plot">
                            <i class="fas fa-redo-alt"></i>
                        </button>
                    </div>
                </div>

                <!-- GPS Auto Detection Box -->
                <div class="p-3 bg-light rounded-4 mb-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-dark"><i class="fas fa-satellite text-primary me-1"></i> Automatic GPS Detection</span>
                        <span id="gpsStatusBadge" class="badge bg-secondary-subtle text-secondary rounded-pill px-2">Ready</span>
                    </div>
                    <p class="text-muted small mb-2" style="font-size: 0.8rem;">
                        Click below to detect your field coordinates via browser geolocation with reverse geocoding.
                    </p>
                    <div class="d-flex gap-2">
                        <button type="button" id="detectGpsBtn" class="btn btn-outline-primary btn-sm rounded-pill w-100">
                            <i class="fas fa-crosshairs me-1"></i> Detect Current GPS Location
                        </button>
                    </div>
                    <div id="gpsAlert" class="small mt-2 d-none"></div>
                </div>

                <!-- Location Fields -->
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Plot Name / पहचान *</label>
                        <input type="text" id="plot_name" class="form-control rounded-pill form-control-sm" placeholder="e.g. North Khet" value="Main Farm Plot" required>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Plot Area (Acres) / रकबा *</label>
                        <input type="number" step="0.1" id="area_acres" class="form-control rounded-pill form-control-sm" placeholder="e.g. 2.5" value="1.0" required>
                    </div>
                </div>

                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">State / UT (राज्य) *</label>
                        <select id="stateSelect" class="form-select rounded-pill form-select-sm" required>
                            <option value="">-- Select State / UT (36 States & UTs) --</option>
                            <% if (typeof regionHierarchy !== 'undefined') { %>
                                <% Object.keys(regionHierarchy).sort().forEach(st => { %>
                                    <option value="<%= st %>" <%= st === 'Uttar Pradesh' ? 'selected' : '' %>><%= st %></option>
                                <% }); %>
                            <% } else { %>
                                <option value="Uttar Pradesh" selected>Uttar Pradesh</option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex justify-content-between align-items-center">
                            <label class="form-label small fw-bold text-muted mb-0">District (ज़िला) *</label>
                            <a href="javascript:void(0)" id="toggleCustomDistrictBtn" class="small text-success text-decoration-none" style="font-size: 0.72rem;">
                                <i class="fas fa-edit"></i> Custom District
                            </a>
                        </div>
                        <select id="districtSelect" class="form-select rounded-pill form-select-sm mt-1" required>
                            <option value="">-- Select District --</option>
                        </select>
                        <input type="text" id="customDistrictInput" class="form-control rounded-pill form-control-sm mt-1 d-none" placeholder="Type custom district / town name">
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Block / Tehsil (तहसील)</label>
                        <input type="text" id="block_tehsil" class="form-control rounded-pill form-control-sm" placeholder="e.g. Sadar / Mohanlalganj" value="Sadar Tehsil">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Village / Gram (गाँव)</label>
                        <input type="text" id="village" class="form-control rounded-pill form-control-sm" placeholder="e.g. Rampur" value="Gram Panchayat Area">
                    </div>
                </div>

                <!-- Coordinates & Soil Texture -->
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Latitude</label>
                        <input type="number" step="0.000001" id="latitude" class="form-control rounded-pill form-control-sm" placeholder="26.8467" value="26.8467">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Longitude</label>
                        <input type="number" step="0.000001" id="longitude" class="form-control rounded-pill form-control-sm" placeholder="80.9462" value="80.9462">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Soil Texture</label>
                        <select id="soil_type" class="form-select rounded-pill form-select-sm">
                            <option value="Loamy Soil" selected>Loamy (दोमट)</option>
                            <option value="Sandy Loam">Sandy Loam (बलुई दोमट)</option>
                            <option value="Clay Loam">Clay Loam (मटियार दोमट)</option>
                            <option value="Black Cotton Soil">Black Soil (काली मिट्टी)</option>
                            <option value="Alluvial Soil">Alluvial (जलोढ़)</option>
                            <option value="Red Laterite">Red / Laterite (लाल मिट्टी)</option>
                        </select>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-outline-success btn-sm rounded-pill" id="quickSavePlotBtn">
                        <i class="fas fa-save me-1"></i> Save as Plot Profile
                    </button>
                    <span id="plotSaveMsg" class="small text-success d-none">Saved!</span>
                </div>
            </div>

            <!-- STEP 2: Soil Test Parameters Form -->
            <div class="glass-card p-4 shadow-sm mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="fas fa-vial text-warning me-2"></i>Step 2: Soil Test Measurements
                </h5>

                <!-- Data Source Selection -->
                <div class="row g-2 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Data Source (परीक्षण का स्रोत) *</label>
                        <select id="data_source" class="form-select rounded-pill form-select-sm">
                            <option value="Government Soil Health Card (SHC)" selected>Govt Soil Health Card (SHC)</option>
                            <option value="Laboratory Report">Certified Lab Report (STL)</option>
                            <option value="Rapid Soil Testing Kit">Rapid Digital/Chemical Kit</option>
                            <option value="Farmer Field Estimate">Farmer Field Estimate</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">SHC Sample / Report No.</label>
                        <input type="text" id="shc_sample_number" class="form-control rounded-pill form-control-sm" placeholder="e.g. SHC-UP-2026-9012">
                    </div>
                </div>

                <!-- Primary Parameters (N, P, K, pH) -->
                <div class="p-3 bg-light rounded-4 border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold small text-dark"><i class="fas fa-atom text-primary me-1"></i> Core Parameters (Required)</span>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">ICAR Mandatory</span>
                    </div>

                    <!-- Nitrogen -->
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-5">
                            <label class="form-label small fw-semibold mb-0">Available Nitrogen (N)</label>
                            <span class="d-block text-muted" style="font-size: 0.72rem;">नत्रजन (Alkaline KMnO4)</span>
                        </div>
                        <div class="col-4">
                            <input type="number" step="0.1" id="n_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 220" value="210" required>
                        </div>
                        <div class="col-3">
                            <select id="n_unit" class="form-select rounded-pill form-select-sm">
                                <option value="kg/ha" selected>kg/ha</option>
                                <option value="ppm">ppm</option>
                            </select>
                        </div>
                    </div>

                    <!-- Phosphorus -->
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-5">
                            <label class="form-label small fw-semibold mb-0">Available Phosphorus (P)</label>
                            <span class="d-block text-muted" style="font-size: 0.72rem;">स्फुर (Olsen / Bray P)</span>
                        </div>
                        <div class="col-4">
                            <input type="number" step="0.1" id="p_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 18" value="16.5" required>
                        </div>
                        <div class="col-3">
                            <select id="p_unit" class="form-select rounded-pill form-select-sm">
                                <option value="kg/ha" selected>kg/ha</option>
                                <option value="ppm">ppm</option>
                            </select>
                        </div>
                    </div>

                    <!-- Potassium -->
                    <div class="row g-2 align-items-center mb-2">
                        <div class="col-5">
                            <label class="form-label small fw-semibold mb-0">Available Potassium (K)</label>
                            <span class="d-block text-muted" style="font-size: 0.72rem;">पोटाश (NH4OAc K)</span>
                        </div>
                        <div class="col-4">
                            <input type="number" step="0.1" id="k_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 195" value="180" required>
                        </div>
                        <div class="col-3">
                            <select id="k_unit" class="form-select rounded-pill form-select-sm">
                                <option value="kg/ha" selected>kg/ha</option>
                                <option value="ppm">ppm</option>
                            </select>
                        </div>
                    </div>

                    <!-- Soil pH -->
                    <div class="row g-2 align-items-center">
                        <div class="col-5">
                            <label class="form-label small fw-semibold mb-0">Soil pH Reaction</label>
                            <span class="d-block text-muted" style="font-size: 0.72rem;">मृदा पीएच (1:2.5 Suspension)</span>
                        </div>
                        <div class="col-4">
                            <input type="number" step="0.1" min="3.0" max="11.0" id="ph_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 6.8" value="6.8" required>
                        </div>
                        <div class="col-3">
                            <span class="badge bg-light text-dark border w-100 py-2 rounded-pill small">pH Scale</span>
                        </div>
                    </div>
                </div>

                <!-- Secondary & Micronutrients (Optional Accordion) -->
                <div class="accordion mb-3" id="microNutrientAccordion">
                    <div class="accordion-item border rounded-4 overflow-hidden">
                        <h2 class="accordion-header" id="headingMicro">
                            <button class="accordion-button collapsed py-2 px-3 bg-light text-dark fw-semibold small" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMicro" aria-expanded="false" aria-controls="collapseMicro">
                                <i class="fas fa-plus-circle text-success me-2"></i> Additional Parameters (EC, Organic Carbon & Micronutrients)
                            </button>
                        </h2>
                        <div id="collapseMicro" class="accordion-collapse collapse" aria-labelledby="headingMicro" data-bs-parent="#microNutrientAccordion">
                            <div class="accordion-body p-3 bg-white">
                                <p class="text-muted small mb-2" style="font-size: 0.78rem;">
                                    Leave blank if not tested. Missing values will NOT be treated as zero.
                                </p>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Electrical Cond. (EC) [dS/m]</label>
                                        <input type="number" step="0.01" id="ec_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 0.45">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Organic Carbon (OC) [%]</label>
                                        <input type="number" step="0.01" id="oc_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 0.55">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Available Sulphur (S) [ppm]</label>
                                        <input type="number" step="0.1" id="s_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 12.0">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Available Zinc (Zn) [ppm]</label>
                                        <input type="number" step="0.01" id="zn_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 0.75">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Available Iron (Fe) [ppm]</label>
                                        <input type="number" step="0.1" id="fe_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 6.2">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Available Boron (B) [ppm]</label>
                                        <input type="number" step="0.01" id="b_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 0.50">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Available Copper (Cu) [ppm]</label>
                                        <input type="number" step="0.01" id="cu_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 0.40">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small text-muted mb-1">Available Manganese (Mn) [ppm]</label>
                                        <input type="number" step="0.1" id="mn_value" class="form-control rounded-pill form-control-sm" placeholder="e.g. 3.5">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Agronomic & Sample Context -->
                <div class="p-3 bg-light rounded-4 border mb-3">
                    <span class="fw-bold small text-dark d-block mb-2"><i class="fas fa-seedling text-success me-1"></i> Step 3: Crop Details & Agronomic Context</span>
                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Target Crop (फसल) *</label>
                            <select id="crop_name" class="form-select rounded-pill form-select-sm" required>
                                <% if (typeof cropCatalog !== 'undefined') { %>
                                    <% Object.keys(cropCatalog).forEach(cropKey => { %>
                                        <option value="<%= cropKey %>" <%= cropKey === 'Wheat' ? 'selected' : '' %>>
                                            <%= cropCatalog[cropKey].name_en %>
                                        </option>
                                    <% }); %>
                                <% } else { %>
                                    <option value="Wheat" selected>Wheat (गेहूं)</option>
                                    <option value="Paddy (Rice)">Paddy / Rice (धान)</option>
                                <% } %>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Season (मौसम) *</label>
                            <select id="season" class="form-select rounded-pill form-select-sm">
                                <option value="Rabi" selected>Rabi (रबी - Winter)</option>
                                <option value="Kharif">Kharif (खरीफ - Monsoon)</option>
                                <option value="Zaid">Zaid (जायद - Summer)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Growth Stage (फसल की अवस्था)</label>
                            <select id="growth_stage" class="form-select rounded-pill form-select-sm">
                                <option value="Pre-sowing / Basal" selected>Pre-sowing / Basal (बुवाई पूर्व)</option>
                                <option value="Tillering / Vegetative">Tillering / Vegetative (कल्ले फूटना)</option>
                                <option value="Flowering / Panicle">Flowering / Heading (फूल / बाली)</option>
                                <option value="Grain Filling / Maturity">Grain Filling (दाना भराव)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Irrigation Type (सिंचाई प्रणाली)</label>
                            <select id="irrigation_type" class="form-select rounded-pill form-select-sm">
                                <option value="Canal / Tube Well (Irrigated)" selected>Canal / Tube Well (Irrigated)</option>
                                <option value="Drip / Sprinkler Micro-irrigation">Drip / Sprinkler Micro-irrigation</option>
                                <option value="Rainfed (Barani)">Rainfed (वर्षा आधारित)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Sample Depth (नमूने की गहराई)</label>
                            <select id="sample_depth" class="form-select rounded-pill form-select-sm">
                                <option value="0-15 cm (Plough layer)" selected>0-15 cm (Plough Layer / ऊपरी मिट्टी)</option>
                                <option value="15-30 cm (Subsoil)">15-30 cm (Subsoil / निचली मिट्टी)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Target Yield (q/ha) [Optional]</label>
                            <input type="number" step="1" id="target_yield" class="form-control rounded-pill form-control-sm" placeholder="e.g. 45" value="45">
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="button" id="runAnalysisBtn" class="btn btn-success btn-lg w-100 py-3 rounded-pill fw-bold shadow">
                    <i class="fas fa-flask me-2"></i> Run Scientific Soil Health Analysis
                </button>
                <div id="formValidationErrors" class="alert alert-danger mt-3 d-none rounded-4 small"></div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Output Report & History -->
        <div class="col-xl-7 col-lg-6">
            <!-- Loading Indicator -->
            <div id="analysisLoading" class="glass-card p-5 text-center d-none shadow-sm animate-fade-in-up">
                <div class="spinner-border text-success mb-3" style="width: 3.5rem; height: 3.5rem;" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h4 class="fw-bold text-dark">Processing Soil Intelligence Engine...</h4>
                <p class="text-muted small">
                    Classifying NPK against ICAR calibration curves, applying STCR fertilizer equations, and generating bilingual advisory narratives.
                </p>
            </div>

            <!-- Placeholder Before First Analysis -->
            <div id="reportPlaceholder" class="glass-card p-5 text-center shadow-sm">
                <i class="fas fa-file-invoice fa-4x text-muted opacity-50 mb-3"></i>
                <h4 class="fw-bold text-dark">Ready for Soil Health Assessment</h4>
                <p class="text-muted small mx-auto" style="max-width: 480px;">
                    Enter your soil test values and farm details on the left, then click <strong>"Run Scientific Soil Health Analysis"</strong> to generate a complete, bilingual decision-support report.
                </p>
            </div>

            <!-- Main Full Bilingual Report Container -->
            <div id="reportContainer" class="d-none">
                <!-- Report Action Bar -->
                <div class="glass-card p-3 mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2 shadow-sm">
                    <!-- Language Switcher Tabs -->
                    <ul class="nav nav-pills" id="langTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active rounded-pill px-3 py-1 fw-bold small" id="en-tab" data-bs-toggle="pill" data-bs-target="#en-content" type="button" role="tab">
                                🇬🇧 English Report
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
