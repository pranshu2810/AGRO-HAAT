                <p class="section-subtitle" data-i18n="sub_subtitle">
                    Farm-fresh, chemical-free vegetables and seasonal produce delivered automatically to your family doorstep.
                </p>
            </div>
            <div class="pricing-grid">
                <!-- Daily Pack -->
                <div class="pricing-card">
                    <h3 data-i18n="sub_daily_title">Daily Fresh Pack</h3>
                    <p style="color: var(--text-muted); font-size: 0.95rem;" data-i18n="sub_daily_desc">Essential daily cooking greens & vegetables</p>
                    <div class="pricing-price">
                        ₹49 <span>/ day</span>
                    </div>
                    <ul class="pricing-features">
                        <li><i class="fa-solid fa-circle-check"></i> Fresh seasonal vegetables daily</li>
                        <li><i class="fa-solid fa-circle-check"></i> Hand-picked from morning harvest</li>
                        <li><i class="fa-solid fa-circle-check"></i> 100% free doorstep delivery</li>
                        <li><i class="fa-solid fa-circle-check"></i> Pause or cancel anytime</li>
                    </ul>
                    <button class="btn-pricing btn-pricing-secondary" onclick="window.location.href='/login'" data-i18n="btn_subscribe">
                        Subscribe Now
                    </button>
                </div>

                <!-- Weekly Pack (Featured) -->
                <div class="pricing-card featured">
                    <span class="featured-ribbon" data-i18n="sub_popular">Most Popular</span>
                    <h3 data-i18n="sub_weekly_title">Weekly Family Basket</h3>
                    <p style="color: var(--text-muted); font-size: 0.95rem;" data-i18n="sub_weekly_desc">Ideal for a family of 3-5 members</p>
                    <div class="pricing-price">
                        ₹99 <span>/ week</span>
                    </div>
                    <ul class="pricing-features">
                        <li><i class="fa-solid fa-circle-check"></i> 6-8 varieties of seasonal veggies</li>
                        <li><i class="fa-solid fa-circle-check"></i> Delivered twice a week</li>
                        <li><i class="fa-solid fa-circle-check"></i> Fixed price guarantee (no market surge)</li>
                        <li><i class="fa-solid fa-circle-check"></i> Priority customer support</li>
                        <li><i class="fa-solid fa-circle-check"></i> Custom veggie swap options</li>
                    </ul>
                    <button class="btn-pricing btn-pricing-primary" onclick="window.location.href='/login'" data-i18n="btn_subscribe">
                        Subscribe Now
                    </button>
                </div>

                <!-- Monthly Pack -->
                <div class="pricing-card">
                    <h3 data-i18n="sub_monthly_title">Monthly Super Value</h3>
                    <p style="color: var(--text-muted); font-size: 0.95rem;" data-i18n="sub_monthly_desc">Complete monthly farm-fresh pantry care</p>
                    <div class="pricing-price">
                        ₹999 <span>/ month</span>
                    </div>
                    <ul class="pricing-features">
                        <li><i class="fa-solid fa-circle-check"></i> Comprehensive weekly large hampers</li>
                        <li><i class="fa-solid fa-circle-check"></i> Free seasonal organic fruit bonuses</li>
                        <li><i class="fa-solid fa-circle-check"></i> Fully customizable produce basket</li>
                        <li><i class="fa-solid fa-circle-check"></i> Dedicated personal hub coordinator</li>
                    </ul>
                    <button class="btn-pricing btn-pricing-secondary" onclick="window.location.href='/login'" data-i18n="btn_subscribe">
                        Subscribe Now
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- IMPACT STATS SECTION -->
    <section class="stats-section reveal">
        <div class="container">
            <h2 class="stats-title" data-i18n="stats_heading">Transforming Agriculture Nationwide</h2>
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number">5,000+</div>
                    <div class="stat-label" data-i18n="stat_farmers">Verified Farmers Connected</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">25,000+</div>
                    <div class="stat-label" data-i18n="stat_customers">Satisfied Urban Families</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">30%</div>
                    <div class="stat-label" data-i18n="stat_income">Higher Farmer Net Earnings</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">40%</div>
                    <div class="stat-label" data-i18n="stat_waste">Reduced Post-Harvest Loss</div>
                </div>
            </div>
        </div>
    </section>

